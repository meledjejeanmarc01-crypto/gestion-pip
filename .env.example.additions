# ==== A AJOUTER / MODIFIER DANS VOTRE FICHIER .env ====

APP_NAME="Projet d'Investissement Public"
APP_LOCALE=fr

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=suivi_investissement_ci
DB_USERNAME=root
DB_PASSWORD=

# --- Diffusion temps réel (Laravel Reverb) ---
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=civ-invest
REVERB_APP_KEY=civ-invest-key
REVERB_APP_SECRET=civ-invest-secret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
